{
  "name": "@investscape/tax-engine",
  "version": "1.0.0",
  "description": "InvestScape Tax Calculation Engines (E46-E53)",
  "license": "SEE LICENSE IN LICENSE.md",
  "main": "./dist/umd/investscape-tax-engine.umd.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "unpkg": "./dist/umd/investscape-tax-engine.umd.js",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/umd/investscape-tax-engine.umd.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run build:clean && npm run build:esm && npm run build:umd",
    "build:esm": "tsc --project tsconfig.esm.json && node -e \"require('fs').writeFileSync('dist/esm/package.json', JSON.stringify({type:'module'}, null, 2))\" && node scripts/fix-esm-extensions.mjs",
    "build:umd": "webpack --config webpack.config.js --mode production",
    "build:clean": "rimraf dist/",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^5.2.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "@types/jest": "^29.5.5",
    "rimraf": "^5.0.0",
    "ts-loader": "^9.4.4",
    "webpack": "^5.88.0",
    "webpack-cli": "^5.1.4"
  }
}
